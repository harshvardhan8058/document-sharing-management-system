# ---------------------------------------------------------------------------
# Document Sharing & Management System — environment configuration
# Copy to `.env` and adjust. Every value below has a safe default, so the app
# boots with an empty .env file.
# ---------------------------------------------------------------------------

# HTTP
PORT=4000
NODE_ENV=development

# Comma separated list of allowed browser origins ("*" allows everything).
# Requests from this server's own origin are always permitted.
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# ---------------------------------------------------------------------------
# Proxy trust — leave OFF unless a reverse proxy really is in front of you.
#
# When enabled, Express believes the X-Forwarded-For header, and the rate
# limiter buckets requests by it. On a directly exposed server that lets a
# client forge its own IP and get a fresh login-attempt budget per request.
#
# false            direct exposure (default)
# 1                exactly one proxy in front (typical: nginx, ALB, Cloudflare)
# 10.0.0.0/8,...   trust only these proxy addresses
# true             trust any hop — least safe, warns at boot
# ---------------------------------------------------------------------------
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Persistence
# DB_DRIVER = mongo   -> uses MONGODB_URI (production / real MongoDB)
# DB_DRIVER = local   -> zero-config embedded JSON store under ./data
# DB_DRIVER = auto    -> "mongo" when MONGODB_URI is set, otherwise "local"
# ---------------------------------------------------------------------------
DB_DRIVER=auto
MONGODB_URI=
LOCAL_DB_DIR=./data

# ---------------------------------------------------------------------------
# Security
# ALWAYS set an explicit JWT_SECRET in production. When omitted in development
# a random secret is generated per boot (tokens are invalidated on restart).
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
# scrypt work factor for password hashing (higher = slower = safer)
PASSWORD_COST=16384

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# Per-account storage allowance, in gigabytes.
STORAGE_QUOTA_GB=2
# Comma separated allow-list of extensions. Empty = allow every extension.
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,csv,json,xml,rtf,odt,png,jpg,jpeg,gif,webp,svg,bmp,zip,tar,gz,mp3,mp4,wav,webm

# ---------------------------------------------------------------------------
# Search inside files
# How much extracted text to keep per document for in-content search. Bounded
# because the local driver holds every record in memory. Only text-ish formats
# are indexed; PDF and docx are containers and need a real parser.
# ---------------------------------------------------------------------------
SEARCH_SNIPPET_KB=16

# ---------------------------------------------------------------------------
# Live updates (Server-Sent Events)
# EventSource cannot send an Authorization header, so the client swaps its
# bearer token for a single-use ticket with the short lifetime below.
# ---------------------------------------------------------------------------
SSE_TICKET_TTL_SECONDS=30
# Comment frames keep idle proxies from closing the connection.
SSE_HEARTBEAT_SECONDS=25
# Concurrent streams per account (one per open tab). Oldest is dropped first.
SSE_MAX_CONNECTIONS_PER_USER=6

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40

# ---------------------------------------------------------------------------
# Data retention. Sweeps run at boot and then on the interval below.
# Set any value to 0 to disable that sweep.
# ---------------------------------------------------------------------------
# Audit entries older than this are deleted (the trail is otherwise unbounded).
ACTIVITY_RETENTION_DAYS=365
# Trashed documents are permanently deleted this long after being trashed.
# Until then they still occupy disk and still count against the owner's quota.
TRASH_RETENTION_DAYS=30
MAINTENANCE_INTERVAL_HOURS=6

# ---------------------------------------------------------------------------
# Seeding (npm run seed)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@dsms.dev
SEED_ADMIN_PASSWORD=Admin@12345
